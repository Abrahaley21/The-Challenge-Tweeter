<%- include('../partials/header', { title }) %>
<section class="auth-card">
  <h1>Welcome back</h1>
  <p>Log in to access Tweeter.</p>
  <% if (error) { %><div class="error">
    <%= error %></div><% } %>
  <form action="/login" method="POST">
    <label for="email">Email address</label>
    <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="email">

    <label for="password">Password
      
    </label>
    <input id="password" name="password" type="password" required autocomplete="current-password">

    <button class="button full" type="submit">Log in</button>
  </form>
  <p class="switch-link">Don't have an account? <a href="/register">Register</a></p>
</section>
<%- include('../partials/footer') %>
