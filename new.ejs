<%- include('../partials/header', { title }) %>
<section class="form-card">
  <h1>Create a tweet</h1>
  <p>Title must be longer than 20 characters. Tweet text can contain up to 50 characters.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form action="/tweets" method="POST">
    <label for="title">Title (minimum 21 characters)</label>
    <input id="title" name="title" type="text" value="<%= values.title %>" minlength="21" required>
    <label for="tweet">Tweet (maximum 50 characters)</label>
    <textarea id="tweet" name="tweet" maxlength="50" required><%= values.tweet %></textarea>
    <small><span id="counter"><%= values.tweet.length %></span>/50 characters</small>
    <button class="button full" type="submit">Submit tweet</button>
  </form>
  <a class="back-link" href="/tweets">← Back to tweets</a>
</section>
<script src="/js/tweet-form.js"></script>
<%- include('../partials/footer') %>
